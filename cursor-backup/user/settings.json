{
    "window.systemColorTheme": "dark",
    "workbench.preferredDarkColorTheme": "Default Dark Modern",
    "cursor.composer.cmdPFilePicker2": true,
    "workbench.colorTheme": "Default Dark Modern",
    "terminal.integrated.defaultProfile.windows": "Command Prompt",
    "terminal.integrated.profiles.windows": {
        "Command Prompt": {
            "path": [
                "${env:windir}\\Sysnative\\cmd.exe",
                "${env:windir}\\System32\\cmd.exe"
            ],
            "args": [],
            "icon": "terminal-cmd"
        }
    },
    "chat.tools.urls.autoApprove": {
        "https://code.visualstudio.com": true,
        "https://github.com/microsoft/vscode/wiki/*": true,
        "https://github.com/github/github-mcp-server": true,
        "https://github.com/github": true
    },
    "chat.mcp.access": "all",
    "chat.mcp.autostart": "newAndOutdated",
    "chat.mcp.apps.enabled": true,
    "githubPullRequests.pullRequestDescription": "Copilot",
    "githubPullRequests.createOnPublishBranch": "prompt",
    "githubPullRequests.defaultMergeMethod": "squash",
    "githubPullRequests.pullRequestTitle": "commit",
    "githubIssues.queries": [
        {
            "label": "Minhas Issues",
            "query": "is:open assignee:@me sort:updated-desc"
        },
        {
            "label": "Criadas por mim",
            "query": "is:open author:@me sort:updated-desc"
        },
        {
            "label": "Mencionando mim",
            "query": "is:open mentions:@me sort:updated-desc"
        }
    ],
    "documentViewer.enableMd": true,
    "documentViewer.enableCsv": true,
    "documentViewer.enableExcel": true,
    "documentViewer.enableWord": true,
    "documentViewer.enablePdf": true,
    "markdown.preview.doubleClickToSwitchToEditor": true,
    "workbench.editorAssociations": {
        "*.md": "syncfusion-rich-text-editor",
        "*.csv": "syncfusion-csv-viewer",
        "*.tsv": "syncfusion-csv-viewer",
        "*.xlsx": "syncfusion-excel-viewer",
        "*.xls": "syncfusion-excel-viewer",
        "*.xltx": "syncfusion-excel-viewer",
        "*.xlt": "syncfusion-excel-viewer",
        "*.docx": "syncfusion-word-viewer",
        "*.doc": "syncfusion-word-viewer",
        "*.dot": "syncfusion-word-viewer",
        "*.dotx": "syncfusion-word-viewer",
        "*.rtf": "syncfusion-word-viewer",
        "*.pdf": "syncfusion-pdf-viewer",
        "*.markdown": "syncfusion-rich-text-editor"
    },
    "cursor.composer.queueMessageDefaultBehavior": "steer",
    "mcp": {
        "servers": {
            "gmail": {
                "url": "https://gmailmcp.googleapis.com/mcp/v1"
            },
            "google-calendar": {
                "url": "https://calendarmcp.googleapis.com/mcp/v1"
            },
            "stitch": {
                "command": "C:\\Users\\USER\\AppData\\Roaming\\npm\\pnpm.cmd",
                "args": [
                    "dlx",
                    "stitch-mcp-stdio"
                ],
                "env": {
                    "STITCH_API_KEY": "${env:STITCH_API_KEY}"
                }
            }
        }
    },
    "markdown.preview.breaks": true,
    "terminal.integrated.commandsToSkipShell": [
        "kilo-code.new.agentManagerOpen",
        "kilo-code.new.agentManager.showTerminal",
        "kilo-code.new.agentManager.previousTerminal",
        "kilo-code.new.agentManager.nextTerminal"
    ],
    "kilo-code.new.agentWorkStyle": "human-in-the-loop",
    "kilo-code.new.showTaskTimeline": false,
    "kilo-code.openAiBaseUrl": "http://localhost:20128/v1",
    "kilo-code.apiKey": "sk-omniroute-local",
    "kilo-code.new.attention.enabled": true,
    "workbench.editor.showTabs": "single",
    "cursor.composer.codeBlockWordWrap": true,
    "window.menuBarVisibility": "visible",
    "window.titleBarStyle": "native",
    "cursor.composer.shouldChimeAfterChatFinishes": true
}
