{
  "mcpServers": {
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${env:GITHUB_TOKEN}",
        "X-MCP-Toolsets": "default,actions,code_security,dependabot,notifications,discussions,projects,labels",
        "X-MCP-Insiders": "true",
        "X-MCP-Features": "remote_mcp_ui_apps"
      }
    },
    "chrome-devtools": {
      "command": "pnpm",
      "args": [
        "dlx",
        "chrome-devtools-mcp@latest",
        "--channel",
        "stable",
        "--workspace",
        "/Users/admin/Documents/INTELIGENCIA-ARTIFICIAL"
      ]
    },
    "playwright": {
      "command": "pnpm",
      "args": [
        "dlx",
        "@playwright/mcp@latest",
        "--browser",
        "chrome"
      ],
      "env": {
        "PLAYWRIGHT_BROWSERS_PATH": "/Users/admin/Library/Caches/ms-playwright"
      }
    },
    "playwright-webkit": {
      "command": "pnpm",
      "args": [
        "dlx",
        "@playwright/mcp@latest",
        "--browser",
        "webkit"
      ],
      "env": {
        "PLAYWRIGHT_BROWSERS_PATH": "/Users/admin/Library/Caches/ms-playwright"
      }
    },
    "safari": {
      "command": "pnpm",
      "args": [
        "dlx",
        "safari-mcp@latest"
      ]
    },
    "stitch": {
      "command": "pnpm",
      "args": [
        "dlx",
        "stitch-mcp-stdio"
      ],
      "env": {
        "STITCH_API_KEY": "${env:STITCH_API_KEY}"
      }
    },
    "higgsfield": {
      "url": "https://mcp.higgsfield.ai/mcp"
    },
    "gmail": {
      "url": "https://gmailmcp.googleapis.com/mcp/v1"
    },
    "google-calendar": {
      "url": "https://calendarmcp.googleapis.com/mcp/v1"
    },
    "premiere": {
      "command": "pnpm",
      "args": [
        "dlx",
        "premiere-pro-mcp"
      ]
    },
    "notebooklm": {
      "command": "pnpm",
      "args": [
        "dlx",
        "@roomi-fields/notebooklm-mcp"
      ]
    },
    "mercadopago": {
      "command": "pnpm",
      "args": [
        "dlx",
        "@theyahia/mercadopago-mcp"
      ]
    },
    "capcut-api": {
      "url": "http://localhost:9001/mcp"
    },
    "google-drive": {
      "url": "https://drivemcp.googleapis.com/mcp/v1"
    }
  }
}
