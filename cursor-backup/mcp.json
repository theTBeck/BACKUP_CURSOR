{
  "mcpServers": {
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${env:GITHUB_TOKEN}",
        "X-MCP-Toolsets": "default,actions,code_security,dependabot,notifications,discussions,projects,labels",
        "X-MCP-Insiders": "true",
        "X-MCP-Features": "remote_mcp_ui_apps"
      }
    },
    "chrome-devtools": {
      "command": "pnpm",
      "args": [
        "dlx",
        "chrome-devtools-mcp@latest"
      ]
    },
    "playwright": {
      "command": "pnpm",
      "args": [
        "dlx",
        "@playwright/mcp@latest"
      ]
    },
    "stitch": {
      "command": "\Users\admin\\AppData\\Roaming\\npm\\pnpm.cmd",
      "args": [
        "dlx",
        "stitch-mcp-stdio"
      ],
      "env": {
        "STITCH_***REDACTED***
      }
    },
    "higgsfield": {
      "url": "https://mcp.higgsfield.ai/mcp"
    },
    "gmail": {
      "url": "https://gmailmcp.googleapis.com/mcp/v1"
    },
    "google-calendar": {
      "url": "https://calendarmcp.googleapis.com/mcp/v1"
    },
    "premiere": {
      "command": "pnpm",
      "args": [
        "dlx",
        "premiere-pro-mcp"
      ]
    },
    "notebooklm": {
      "command": "pnpm",
      "args": [
        "dlx",
        "@roomi-fields/notebooklm-mcp"
      ]
    },
    "mercadopago": {
      "command": "pnpm",
      "args": [
        "dlx",
        "@theyahia/mercadopago-mcp"
      ]
    },
    "capcut": {
      "command": "node",
      "args": [
        "\Users\admin\Documents\INTELIGENCIA-ARTIFICIAL\\CONNECTIONS\\repos\\CapCut-Draft-MCP\\src\\server.js"
      ],
      "env": {
        "CAPCUT_DRAFTS_DIR": "\Users\admin\\AppData\\Local\\CapCut\\User Data\\Projects\\com.lveditor.draft",
        "CAPCUT_TEMPLATE_DRAFT": "dop-reel-v5"
      }
    },
    "capcut-api": {
      "url": "http://localhost:9001/mcp"
    },
    "google-drive": {
      "url": "https://drivemcp.googleapis.com/mcp/v1"
    }
  }
}
