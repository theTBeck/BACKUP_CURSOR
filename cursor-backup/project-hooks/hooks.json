{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node .cursor/hooks/repos-cursor-guard.js"
      }
    ],
    "preToolUse": [
      {
        "command": "node .cursor/hooks/repos-cursor-guard.js",
        "matcher": "Write|Shell|Delete|StrReplace",
        "failClosed": false
      }
    ]
  }
}
